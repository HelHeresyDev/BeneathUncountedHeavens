  "variables": [
    {
      "id": 1,
      "name": "back_ease",
      "formula": "8",
      "description": "Ease added across the back panel"
    },
    {
      "id": 2,
      "name": "front_ease",
      "formula": "8",
      "description": "Ease added across the front"
    },
    {
      "id": 3,
      "name": "over_layer_ease",
      "formula": "6",
      "description": "Extra width so the robe can be worn over an inner layer"
    },
    {
      "id": 4,
      "name": "hem_drop",
      "formula": "58",
      "description": "From the waist line down to the hem"
    },
    {
      "id": 5,
      "name": "crossover_overlap",
      "formula": "8",
      "description": "How far each front panel's crossover edge passes the centre front"
    },
    {
      "id": 6,
      "name": "armhole_depth",
      "formula": "18",
      "description": "From the shoulder line down to the underarm"
    },
    {
      "id": 7,
      "name": "armhole_control",
      "formula": "12",
      "description": "Control length of the body armhole curves"
    },
    {
      "id": 8,
      "name": "sleeve_length",
      "formula": "55",
      "description": "From the shoulder line down to the sleeve hem"
    },
    {
      "id": 9,
      "name": "sleeve_flare",
      "formula": "12",
      "description": "How far each sleeve side seam flares out to the hem"
    },
    {
      "id": 10,
      "name": "armhole_half_width",
      "formula": "16",
      "description": "Half the distance between the sleeve's two shoulder points"
    },
    {
      "id": 11,
      "name": "armhole_dip",
      "formula": "15",
      "description": "How far the sleeve armhole dips below the shoulder line"
    },
    {
      "id": 12,
      "name": "armhole_dip_control",
      "formula": "11.74",
      "description": "Control length of the sleeve armhole curves"
    },
    {
      "id": 13,
      "name": "collar_width",
      "formula": "6",
      "description": "Width of the collar band"
    },
    {
      "id": 14,
      "name": "sash_width",
      "formula": "9",
      "description": "Width of the waist sash"
    },
    {
      "id": 15,
      "name": "sash_overlap",
      "formula": "15",
      "description": "Overlap of the sash when tied"
    },
    {
      "id": 16,
      "name": "neck_width",
      "formula": "16",
      "description": "Width of the neck opening at the base of the neck"
    },
    {
      "id": 17,
      "name": "shoulder_length",
      "formula": "@shoulder_length",
      "description": "Neck side point to shoulder point"
    },
    {
      "id": 18,
      "name": "back_width",
      "formula": "@across_back + {1} / 2 + {3} / 2",
      "description": "Width of the back panel"
    },
    {
      "id": 19,
      "name": "robe_length",
      "formula": "@neck_back_to_waist + {4}",
      "description": "From the neck line down to the hem"
    },
    {
      "id": 20,
      "name": "waist_y",
      "formula": "@neck_back_to_waist",
      "description": "Height of the waist line below the neck line"
    },
    {
      "id": 21,
      "name": "inner_x",
      "formula": "{18} / 2 + {5} / 2",
      "description": "X of each front panel's crossover edge at the waist"
    },
    {
      "id": 22,
      "name": "collar_length",
      "formula": "{16} + sqrt(({21} - {17}) * ({21} - {17}) + {20} * {20})",
      "description": "Length of the collar band: neck opening plus the crossover diagonal"
    },
    {
      "id": 23,
      "name": "sash_length",
      "formula": "@waist_circumference + {15}",
      "description": "Length of the waist sash"
    }
  ],
